<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="privilege_bp_it_consumable" model="res.groups.privilege">
        <field name="name">IT Consumables</field>
        <field name="description">Manage IT Consumables and Supplier Requests.</field>
        <field name="sequence">11</field>
    </record>

    <record id="group_bp_it_consumable_user" model="res.groups">
        <field name="name">User (Consumables)</field>
        <field name="privilege_id" ref="privilege_bp_it_consumable"/>
        <field name="implied_ids" eval="[(4, ref('bp_it_equipment.group_bp_it_equipment_user'))]"/>
        <field name="comment">User: can view own consumable requests. Inherits Equipment User.</field>
    </record>

    <record id="group_bp_it_consumable_admin" model="res.groups">
        <field name="name">Administrator (Consumables)</field>
        <field name="privilege_id" ref="privilege_bp_it_consumable"/>
        <field name="implied_ids" eval="[(4, ref('bp_it_equipment.group_bp_it_equipment_admin')), (4, ref('group_bp_it_consumable_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Admin: full access to all consumable records. Inherits Equipment Admin.</field>
    </record>

</odoo>