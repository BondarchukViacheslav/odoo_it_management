<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bp_it_consumable_consumable_view_list" model="ir.ui.view">
        <field name="name">bp.it.consumable.consumable.view.list</field>
        <field name="model">bp.it.consumable.consumable</field>
        <field name="arch" type="xml">
            <list decoration-danger="qty_available &lt;= qty_min">
                <header>
                    <button name="%(bp_it_consumable.bp_it_consumable_request_wizard_action)d"
                            string="Generate Requests"
                            type="action"
                            class="btn-primary"
                            display="always"/>
                </header>

                <field name="name"/>
                <field name="category_id"/>
                <field name="qty_available"/>
                <field name="qty_min"/>
            </list>
        </field>
    </record>

    <record id="bp_it_consumable_consumable_view_form" model="ir.ui.view">
        <field name="name">bp.it.consumable.consumable.view.form</field>
        <field name="model">bp.it.consumable.consumable</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Consumable Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="compatible_equipment_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="qty_available"/>
                            <field name="qty_min"/>
                            <field name="qty_order"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bp_it_consumable_consumable_view_kanban" model="ir.ui.view">
        <field name="name">bp.it.consumable.consumable.view.kanban</field>
        <field name="model">bp.it.consumable.consumable</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/> <field name="name"/>
                <field name="category_id"/>
                <field name="qty_available"/>
                <field name="qty_min"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div class="text-muted"><field name="category_id"/></div>
                            <div t-attf-class="mt-2 #{record.qty_available.raw_value &lt;= record.qty_min.raw_value ? 'text-danger fw-bold' : 'text-success'}">
                                <i class="fa fa-cubes"/> Qty: <field name="qty_available"/> / Min: <field name="qty_min"/>
                            </div>
                            <div class="mt-3">
                                <button name="action_create_issue" type="object" class="btn btn-primary btn-sm">
                                    <i class="fa fa-share-square-o"/> Issue
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="bp_it_consumable_consumable_view_pivot" model="ir.ui.view">
        <field name="name">bp.it.consumable.consumable.view.pivot</field>
        <field name="model">bp.it.consumable.consumable</field>
        <field name="arch" type="xml">
            <pivot string="Compatibility Analysis" sample="1">
                <field name="compatible_equipment_ids" type="row"/>
                <field name="name" type="row"/>

                <field name="qty_available" type="measure"/>
                <field name="qty_min" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="bp_it_consumable_consumable_action" model="ir.actions.act_window">
        <field name="name">Consumables Catalog</field>
        <field name="res_model">bp.it.consumable.consumable</field>
        <field name="view_mode">kanban,list,pivot,form</field>
    </record>
</odoo>