<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bp_it_consumable_request_view_search" model="ir.ui.view">
        <field name="name">bp.it.consumable.request.view.search</field>
        <field name="model">bp.it.consumable.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <group>
                    <filter string="State" name="group_by_state" context="{'group_by':'state'}"/>
                    <filter string="Supplier" name="group_by_partner" context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bp_it_consumable_request_view_list" model="ir.ui.view">
        <field name="name">bp.it.consumable.request.view.list</field>
        <field name="model">bp.it.consumable.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state == 'received'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="request_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="bp_it_consumable_request_view_form" model="ir.ui.view">
        <field name="name">bp.it.consumable.request.view.form</field>
        <field name="model">bp.it.consumable.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ordered,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" domain="[('is_consumable_supplier', '=', True)]"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="consumable_id"/>
                                    <field name="qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bp_it_consumable_request_action" model="ir.actions.act_window">
        <field name="name">Supplier Requests</field>
        <field name="res_model">bp.it.consumable.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>