<odoo>

    <record id="privilege_bp_it_management" model="res.groups.privilege">
        <field name="name">IT Infrastructure Management</field>
        <field name="description">Helps you manage IT assets and equipment assignments.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_bp_it_equipment_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_bp_it_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Regular user: can view equipment and assignments.</field>
    </record>

    <record id="group_bp_it_equipment_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_bp_it_management"/>
        <field name="implied_ids" eval="[(4, ref('group_bp_it_equipment_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')),(4, ref('base.user_admin'))]"/>
        <field name="comment">Admin: full access to all IT infrastructure records.</field>
    </record>

</odoo>
