<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bp_it_consumable_request_line_view_list" model="ir.ui.view">
        <field name="name">bp.it.consumable.request.line.view.list</field>
        <field name="model">bp.it.consumable.request.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="request_id"/>
                <field name="consumable_id"/>
                <field name="qty"/>
            </list>
        </field>
    </record>

    <record id="bp_it_consumable_request_line_view_form" model="ir.ui.view">
        <field name="name">bp.it.consumable.request.line.view.form</field>
        <field name="model">bp.it.consumable.request.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="request_id"/>
                        <field name="consumable_id"/>
                        <field name="qty"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>