<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="demo_request_1" model="bp.it.consumable.request">
            <field name="partner_id" ref="demo_partner_supplier_1"/>
            <field name="state">draft</field>
            <field name="request_date" eval="time.strftime('%Y-%m-%d')"/>
        </record>

        <record id="demo_request_2" model="bp.it.consumable.request">
            <field name="partner_id" ref="demo_partner_supplier_2"/>
            <field name="state">ordered</field>
            <field name="request_date" eval="(datetime.now() - relativedelta(days=3)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="demo_request_3" model="bp.it.consumable.request">
            <field name="partner_id" ref="demo_partner_supplier_3"/>
            <field name="state">received</field>
            <field name="request_date" eval="(datetime.now() - relativedelta(days=10)).strftime('%Y-%m-%d')"/>
        </record>
    </data>
</odoo>