<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bp_it_consumable_issue_view_list" model="ir.ui.view">
        <field name="name">bp.it.consumable.issue.view.list</field>
        <field name="model">bp.it.consumable.issue</field>
        <field name="arch" type="xml">
            <list>
                <field name="issue_date"/>
                <field name="consumable_id"/>
                <field name="employee_id" widget="many2one_avatar_user"/>
                <field name="equipment_id"/>
                <field name="qty"/>
            </list>
        </field>
    </record>

    <record id="bp_it_consumable_issue_view_form" model="ir.ui.view">
        <field name="name">bp.it.consumable.issue.view.form</field>
        <field name="model">bp.it.consumable.issue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="consumable_id"/>
                            <field name="qty"/>
                            <field name="issue_date"/>
                        </group>
                        <group>
                            <field name="employee_id" widget="many2one_avatar_user"/>
                            <field name="compatible_equipment_ids" invisible="1"/>
                            <field name="equipment_id" domain="compatible_equipment_ids and [('id', 'in', compatible_equipment_ids)] or []"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bp_it_consumable_issue_view_pivot" model="ir.ui.view">
        <field name="name">bp.it.consumable.issue.view.pivot</field>
        <field name="model">bp.it.consumable.issue</field>
        <field name="arch" type="xml">
            <pivot string="Consumable Issues Analysis" sample="1">
                <field name="equipment_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="consumable_id" type="row"/>

                <field name="issue_date" type="col" interval="month"/>

                <field name="qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="bp_it_consumable_issue_action" model="ir.actions.act_window">
        <field name="name">Issue Log</field>
        <field name="res_model">bp.it.consumable.issue</field>
        <field name="view_mode">list,pivot,form</field>
    </record>
</odoo>