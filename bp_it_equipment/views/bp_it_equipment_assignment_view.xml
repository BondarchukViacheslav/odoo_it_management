<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bp_it_equipment_assignment_view_list" model="ir.ui.view">
        <field name="name">bp.it.equipment.assignment.view.list</field>
        <field name="model">bp.it.equipment.assignment</field>
        <field name="arch" type="xml">
            <list string="Assignments" decoration-info="state == 'draft'" decoration-success="state == 'active'"
                  decoration-muted="state == 'returned'">
                <field name="name" string="ID"/>
                <field name="equipment_id"/>
                <field name="employee_id" widget="many2one_avatar_user"/>
                <field name="date_start"/>
                <field name="date_end" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'returned'"/>
                <field name="equipment_state"
                       widget="badge"
                       decoration-danger="equipment_state == 'damaged'"
                       decoration-warning="equipment_state == 'in_repair'"/>
            </list>
        </field>
    </record>

    <record id="bp_it_equipment_assignment_view_form" model="ir.ui.view">
        <field name="name">bp.it.equipment.assignment.view.form</field>
        <field name="model">bp.it.equipment.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm Assignment" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_return" string="Return Equipment" type="object"
                            invisible="state != 'active'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,active,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Primary Info">
                            <field name="equipment_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="employee_id" widget="many2one_avatar_user"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Dates">
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'active'"
                                   invisible="state == 'draft'"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <chatter/>
                </div>
            </form>
        </field>
    </record>

    <record id="bp_it_equipment_assignment_view_search" model="ir.ui.view">
        <field name="name">bp.it.equipment.assignment.view.search</field>
        <field name="model">bp.it.equipment.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="employee_id"/>
                <filter string="Active Assignments" name="filter_active" domain="[('state', '=', 'active')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Equipment" name="group_by_equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bp_it_equipment_assignment_action" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">bp.it.equipment.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bp_it_equipment_assignment_view_search"/>
        <field name="context">{
            'search_default_filter_active': 1
            'search_default_group_by_employee': 1
            }
        </field>
    </record>
</odoo>
