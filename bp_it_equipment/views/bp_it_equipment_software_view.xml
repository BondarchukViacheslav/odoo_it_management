<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bp_it_equipment_software_view_list" model="ir.ui.view">
        <field name="name">bp.it.equipment.software.view.list</field>
        <field name="model">bp.it.equipment.software</field>
        <field name="arch" type="xml">
            <list string="Software" decoration-danger="expiration_date and expiration_date &lt; current_date">
                <field name="name"/>
                <field name="software_type"/>
                <field name="license_type"/>
                <field name="license_required" widget="boolean_toggle"/>
                <field name="license_key"/>
                <field name="license_status" widget="badge"
                       decoration-danger="license_status == 'missing'"
                       decoration-success="license_status == 'valid'"
                       decoration-info="license_status == 'not_required'"/>
                <field name="equipment_id"/>
                <field name="expiration_date" widget="remaining_days"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="bp_it_equipment_software_action" model="ir.actions.act_window">
        <field name="name">Software</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bp.it.equipment.software</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first software!
            </p>
        </field>
    </record>

</odoo>
