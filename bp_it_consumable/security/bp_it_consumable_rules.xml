<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_bp_it_consumable_request_user_own" model="ir.rule">
        <field name="name">User: See own consumable requests</field>
        <field name="model_id" ref="model_bp_it_consumable_request"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_bp_it_consumable_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_bp_it_consumable_request_admin_all" model="ir.rule">
        <field name="name">Admin: See all consumable requests</field>
        <field name="model_id" ref="model_bp_it_consumable_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_bp_it_consumable_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>