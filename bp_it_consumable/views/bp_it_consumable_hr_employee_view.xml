<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bp_it_consumable_view_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.consumable</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(bp_it_consumable.bp_it_consumable_issue_action)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        context="{'search_default_employee_id': id, 'default_employee_id': id}">
                    <div class="o_stat_info">
                        <field name="consumable_issue_count" class="o_stat_value"/>
                        <span class="o_stat_text">Consumables</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>