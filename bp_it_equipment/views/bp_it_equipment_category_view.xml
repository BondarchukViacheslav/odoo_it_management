<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="bp_it_equipment_category_view_list" model="ir.ui.view">
            <field name="name">bp.it.equipment.category.view.list</field>
            <field name="model">bp.it.equipment.category</field>
            <field name="arch" type="xml">
                <list string="Equipment Categories">
                    <field name="name"/>
                    <field name="equipment_count" string="Total Items"/>
                </list>
            </field>
        </record>

        <record id="bp_it_equipment_category_view_form" model="ir.ui.view">
            <field name="name">bp.it.equipment.category.view.form</field>
            <field name="model">bp.it.equipment.category</field>
            <field name="arch" type="xml">
                <form string="Equipment Category">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Category Name"/>
                            <h1>
                                <field name="name" placeholder="e.g. Laptops"/>
                            </h1>
                        </div>

                        <notebook>
                            <page string="Assigned Equipment" name="equipment_list">
                                <field name="equipment_ids" readonly="1">
                                    <list string="Equipment Details">
                                        <field name="name"/>
                                        <field name="serial_number"/>
                                        <field name="inventory_number"/>
                                        <field name="state" widget="badge"
                                               decoration-info="state == 'available'"
                                               decoration-warning="state == 'repair'"
                                               decoration-success="state == 'assigned'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="bp_it_equipment_category_action" model="ir.actions.act_window">
            <field name="name">Equipment Categories</field>
            <field name="res_model">bp.it.equipment.category</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define your equipment categories here.
                </p>
            </field>
        </record>
    </data>
</odoo>
