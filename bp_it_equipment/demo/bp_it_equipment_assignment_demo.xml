<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_assignment_monitor" model="bp.it.equipment.assignment">
        <field name="equipment_id" ref="demo_equipment_monitor_1"/>
        <field name="employee_id" model="hr.employee" search="[('user_id', '=', ref('base.user_admin'))]"/>
        <field name="date_start" eval="time.strftime('%Y-01-15')"/>
        <field name="state">active</field>
    </record>

    <record id="demo_assignment_mac" model="bp.it.equipment.assignment">
        <field name="equipment_id" ref="demo_equipment_laptop_1"/>
        <field name="employee_id" model="hr.employee" search="[('user_id', '=', ref('base.user_admin'))]"/>
        <field name="date_start" eval="time.strftime('%Y-03-01')"/>
        <field name="date_end" eval="time.strftime('%Y-03-10')"/>
        <field name="state">returned</field>
    </record>

    <record id="demo_assignment_printer" model="bp.it.equipment.assignment">
        <field name="equipment_id" ref="demo_equipment_printer_1"/>
        <field name="employee_id" model="hr.employee" search="[('user_id', '=', ref('base.user_demo'))]"/>
        <field name="date_start" eval="time.strftime('%Y-01-01')"/>
        <field name="date_end" eval="time.strftime('%Y-02-28')"/>
        <field name="state">returned</field>
    </record>
</odoo>
